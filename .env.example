# =============================================================================
# TDK Design & Build — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in the values.
# See each section for where to obtain credentials.

# SANITY CMS (https://sanity.io/manage → Your Project → Settings → API)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=

# RESEND (https://resend.com/api-keys)
# Set these in the deployment's Production environment as well as .env.local.
# The sender domain must be verified in the Resend account owning the API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_FORM_TO_EMAIL=
INTEREST_FORM_TO_EMAIL=

# BREVO CRM — server-only. Keep disabled until configuration/preview checks pass.
BREVO_ENABLED=false
BREVO_API_KEY=
BREVO_LIST_ID=3
BREVO_PIPELINE_ID=6acd18d26b19db2a45b1cef1
BREVO_NEW_INQUIRY_STAGE_ID=0e5173b4643c420bbacdd97cc7d22450
# Optional owner email or Brevo user ID for assigning new deals.
BREVO_DEAL_OWNER=
# Random secret for the authenticated Vercel daily retry worker.
CRON_SECRET=

# BREVO MARKETING WEBHOOK → instant Meta lead alert (POST /api/webhooks/brevo-lead).
# Random secret; the Brevo webhook URL carries it as ?secret=<value>. Alerts go
# to LEAD_ALERT_TO_EMAIL (falls back to CONTACT_FORM_TO_EMAIL) through Resend.
# List 4 is "TDK | Meta Leads".
BREVO_WEBHOOK_SECRET=
LEAD_ALERT_TO_EMAIL=
BREVO_META_LEADS_LIST_ID=4

# META PIXEL + CONVERSIONS API. Both only run after cookie consent.
# The Pixel ID is public; the access token is server-only (never NEXT_PUBLIC_).
# Set META_TEST_EVENT_CODE only while checking Events Manager → Test events.
NEXT_PUBLIC_META_PIXEL_ID=1247719394125049
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# INDEXNOW (Bing and partner engines). The key is public by design: the same
# value is served as public/<key>.txt so engines can verify it.
INDEXNOW_KEY=

# Images are stored in Sanity (uploaded in the Studio) — no image CDN keys needed.

# ANALYTICS
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# SITE
NEXT_PUBLIC_SITE_URL=
